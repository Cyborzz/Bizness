NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=https://fidelise-moi.fr

# Web Push
# Generate once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@fidelise-moi.fr

# Daily reengagement cron, sent as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Google Wallet (carte de fidélité dans Google Wallet)
# GOOGLE_WALLET_ISSUER_ID : Issuer ID de la console Google Pay & Wallet
# GOOGLE_WALLET_SERVICE_ACCOUNT : clé JSON du compte de service (JSON brut OU base64)
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT=

# V2 - Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# V2 - Transactional email
RESEND_API_KEY=
RESEND_FROM=hello@fidelise-moi.fr
