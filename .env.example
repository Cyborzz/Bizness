NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Web Push (générer une fois : npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@fideliqr.com

# Cron de réengagement push (/api/cron/reengage) — secret partagé avec Vercel Cron.
# Générer un secret aléatoire, ex. : openssl rand -hex 32
CRON_SECRET=

# V2 - Stripe (nécessite un compte stripe.com)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# V2 - Email transactionnel (Resend recommandé : resend.com)
RESEND_API_KEY=
RESEND_FROM=hello@fideliqr.com
